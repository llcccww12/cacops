<script>
  ; (function () {
    var wechatSignUpRequired = {{.WechatSignUpRequired}};
    if (!wechatSignUpRequired) {
      var searchParams = new URLSearchParams(window.location.search);
      window.location.href = '/user/login?' + searchParams.toString();
      return;
    }
  })();
</script>
{{template "base/head" .}}
{{template "user/auth/galaxy_bg" .}}
<style>
  .qrcode-c {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 150px;
    margin: 0px 0 18px 0;
  }
  .qrcode {
    width: 148px;
    height: 148px;
    position: relative;
  }
  .qrcode-img,
  .qrcode-refresh {
    width: 100%;
    height: 100%;
    position: absolute;
  }
  .qrcode-refresh {
    cursor: pointer;
  }
  .qrcode-tips {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }
  .qrcode-tips i {
    font-size: 20px;
    margin-right: 6px;
    color: rgb(0, 194, 80);
  }
</style>
<style>
	@media only screen and (max-width: 1200px) {
		._container {
			display:block !important;
		}
   	._left-img-area {
	 		display: none;
	 	}
	 	._right_content_area { }
	 	._right_content_area .segment {	 
			margin-left: auto !important;
			border-top-left-radius: .28571429rem !important;
			border-bottom-left-radius: .28571429rem !important;
			border-left: border: 1px solid rgba(34,36,38,.15) !important;
	 	}
  }
</style>
<div class="user signin">
	<div class="ui container" style="margin-top:60px;">
		<div class="_container" style="display:flex;justify-content:center;">
			<div class="_left-img-area" style="padding-right:0;flex:2">
				<div style="width:450px;height:100%;float:right;border-radius:0.28571429rem;border-top-right-radius: 0;
					border-bottom-right-radius: 0;border-right:none !important;overflow: hidden;
					-webkit-box-shadow: 0 2px 4px 0 rgba(34,36,38,.12),0 2px 10px 0 rgba(34,36,38,.15);
					box-shadow: 0 2px 4px 0rgba(34,36,38,.12),0 2px 10px 0rgba(34,36,38,.15);">
					{{ if .ActivityTpl }}
						{{ .ActivityTpl | Safe}}
					{{ else }}
						{{ template "user/auth/signin_up_img_default" .}}
					{{ end }}
				</div>
			</div>
			<div class="_right_content_area" style="padding-left:0;flex:3;">
				<div class="ui raised very padded text container segment" style="margin-left:0;
				border-top-left-radius: 0;
					border-bottom-left-radius: 0;
					border-left: none !important;
          min-height: 410px;
				">
					{{template "user/auth/signin_navbar" .}}					
					<style>
					.full.height{background-color: #F9F9F9;}
					.ui.left:not(.action){ float:none;}
					.ui.left{ float:none;}
					.ui.secondary.pointing.menu{ border-bottom:none;}
					</style>
					{{template "base/alert" .}}
					<div class="ui negative message err-info-c" style="display:none;">
						<p></p>
					</div>
					<div class="ui centered grid">
						<div class="sixteen wide mobile ten wide tablet ten wide computer column">
							<div class="ui bottom aligned two column grid">
								<div class="column">
									<h2 class="ui header">
										{{if .LinkAccountMode}}
											{{.i18n.Tr "auth.oauth_signin_title"}}
										{{else}}
											{{.i18n.Tr "auth.login_userpass"}}
										{{end}}
									</h2>						
								</div>
								{{if .ShowRegistrationButton}}
									<div class="ui right floated column">
									<a href="{{AppSubUrl}}/user/sign_up">{{.i18n.Tr "auth.sign_up_now" | Str2html}}</a>
								</div>
							{{end}}
							</div>
							<div class="ui grid">
								<div class="column">
									<form id="wechat-login" class="ui form" action="/user/login/wechat" method="post">
									{{.CsrfTokenHtml}}
									<input type="hidden" name="login_id" value="">
                  <div class="qrcode-c">
										<div class="qrcode">
											<img class="qrcode-img" src="" style="display:none" />
											<img class="qrcode-refresh" style="display:none" src="https://files.wondercv.com/auth/qrcode_reload.png">
										</div>
									</div>
									<div class="qrcode-tips">
										<i class="ri-wechat-fill"></i></i><span>{{.i18n.Tr "phone.wechat_login_msg"}}</span>
									</div>
                
						      {{template "user/auth/signin_thirdparty" .}}
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>		
	</div>
</div>
<script>
  ; (function () {
    var states = {
      codeInfo: {},
      refreshTimer: null,
      codeState: 0,
    };
    var urlSearchParams = new URLSearchParams(window.location.search);
    var refreshCodeState = function () {
      states.refreshTimer && clearInterval(states.refreshTimer);
      states.refreshTimer = setInterval(function () {
        $.ajax({
          url: '/authentication/wechat/bindStatus?sceneStr=' + states.codeInfo.QRCode.SceneStr,
          type: 'get',
          dataType: 'json',
          success: function (res) {
            states.codeState = res.data.status;
            if (states.codeState == 9) { // expired
              clearInterval(states.refreshTimer);
              $('.qrcode-refresh').show();
            } else if (states.codeState == 2) { // success
              clearInterval(states.refreshTimer);
              var searchParams = new URLSearchParams(window.location.search);
              loginPost();
            } else if (states.codeState == 0) { // scaning                
            }
          },
          error: function (err) {
            console.log(err);
          },
        });
      }, 2000);
    }
    var getQRCode = function (stayErr) {
			if (!stayErr) {
      	$('.err-info-c p').text('').parent().hide();
			}
      states.refreshTimer && clearInterval(states.refreshTimer);
      $.ajax({
        url: '/user/login/wechat/qrcode',
        type: 'get',
        dataType: 'json',
        success: function (res) {
          if (res.Code == 0) {
            states.codeInfo = res.Data;
            states.codeInfo.imgSrc = 'https://mp.weixin.qq.com/cgi-bin/showqrcode?ticket=' + res.Data.QRCode.Ticket;
            $('.qrcode-img').attr('src', states.codeInfo.imgSrc).show();
            $('.qrcode-refresh').hide();
            refreshCodeState();
          } else {
            $('.qrcode-refresh').show();
          }
        },
        error: function (err) {
          console.log(err);
          $('.qrcode-refresh').show();
        },
      });
    };
    var loginPost = function () {
      if(states.codeInfo.LoginId){
        document.querySelector('#wechat-login input[name="login_id"]').value = states.codeInfo.LoginId;
        document.getElementById('wechat-login').submit();
      }
      
      // var redirectUrl = getCookie('redirect_to') || new URLSearchParams(window.location.search).get('redirect_to');
      // var ajaxHandler = $.ajax({
      //   url: window.location.href,
      //   method: 'post',
      //   xhrFields: { withCredentials: true },
      //   data: { login_id: states.codeInfo.LoginId },
      //   success: function (res, status, xhr) {
      //     if (xhr.responseJSON) {
      //       $('.err-info-c p').text(res.msg).parent().show();
      //       if (res.code == 3001) { // 已过期，请重新扫码
      //         $('.qrcode-refresh').show();
			// 				return;
      //       }
			// 			var stayErr = true;
			// 			getQRCode(stayErr);
      //     } else {
      //       if (redirectUrl) {
      //         window.location.href = redirectUrl;
      //       } else {
      //         window.location.reload();
      //       }
      //     }
      //   },
      //   error: function (err) {
      //     console.log(err);
      //   },
      // });
    };
    window.addEventListener('load', function () {
      getQRCode();
      $('.qrcode-refresh').on('click', function() {
        getQRCode();
      });
    });
  })();
</script>
{{template "base/footer" .}}
