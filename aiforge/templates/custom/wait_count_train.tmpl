<div class="tooltip-wati-count" style="margin-left: 155px">
	{{$queue := ""}}
	{{$gpuQueue := 0}}
	{{range $k,$v :=.type}}
	{{if eq $k 0}}
	{{ $queue = $v.Queue }}
	{{ end }}
	{{ end }}

	{{ range $k,$v :=.ctx.QueuesDetail }}
	{{if eq $k $queue}}
	{{$gpuQueue =$v}}
	{{ end }}
	{{ end }}
	<i
		class="ri-error-warning-line"
		style="margin-right: 0.5rem; font-size: 14px"
	></i>
	<span id="gpu-nums" style="font-size: 12px"
		>{{.ctx.i18n.Tr "repo.wait_count_start"}}
		{{if .ctx.QueuesDetail}}
		{{ $gpuQueue }}
		{{else}}
		{{.ctx.WaitCount}}
		{{ end }}
		{{.ctx.i18n.Tr "repo.wait_count_end"}}</span
	>
</div>
