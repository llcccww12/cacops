{{template "base/head" .}}
<div class="organization teams">
	{{template "org/header" .}}
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="ui grid">
			{{template "org/team/sidebar" .}}
			<div class="ui ten wide column">
				{{template "org/team/navbar" .}}
				{{$canAddRemove := and $.IsOrganizationOwner (not $.Team.IncludesAllAimodels)}}
				{{if $canAddRemove}}
					<div class="ui attached segment" id="repo-top-segment">
						<div class="inline ui field left">
							<form class="ui form" id="add-repo-form" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/aimodel/add" method="post">
								{{.CsrfTokenHtml}}
								<div class="inline field ui left">
									<div id="search-dataset-box" data-name="{{.Org.Name}}"  data-type="aimodel" class="ui search">
										<div class="ui input">
											<input class="prompt" id="dataset-name-display" placeholder="{{.i18n.Tr "org.teams.search_models_placeholder"}}" autocomplete="off" required>
											<input type="hidden" id="dataset-id-value" name="aimodel_id">
										</div>
									</div>
								</div>
								<button class="ui green button">{{.i18n.Tr "add"}}</button>
							</form>
						</div>
						<div class="inline ui field right">
							<form class="ui form" id="repo-multiple-form" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/aimodels" method="post">
								<button class="ui red button delete-button right" data-url="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/aimodel/removeall">{{.i18n.Tr "remove_all"}}</button>
								<button class="ui green button add-all-button right" data-url="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/aimodel/addall">{{.i18n.Tr "add_all"}}</button>
							</form>
						</div>
					</div>
				{{end}}
				<div class="ui bottom attached table segment repositories">
					{{range .Team.Aimodels}}
						<div class="item">
							{{if $canAddRemove}}
								<form method="post" action="{{$.OrgLink}}/teams/{{$.Team.LowerName}}/action/aimodel/remove">
									{{$.CsrfTokenHtml}}
									<button type="submit" class="ui red small button right" name="aimodel_id" value="{{.ID}}">{{$.i18n.Tr "remove"}}</button>
								</form>
							{{end}}
							<a class="member" href="{{AppSubUrl}}/models/detail/{{$.Org.Name}}/{{.Name}}">
								<strong>{{$.Org.Name}}/{{.Alias}}</strong>
							</a>
						</div>
					{{else}}
						<div class="item">
							<span class="text grey italic">{{$.i18n.Tr "org.teams.models.none"}}</span>
						</div>
					{{end}}
				</div>
			</div>
		</div>
	</div>
</div>

<div class="ui small basic delete modal">
	<div class="ui icon header">
		<i class="trash icon"></i>
		{{.i18n.Tr "org.teams.remove_all_models_title"}}
	</div>
	<div class="content">
		<p>{{.i18n.Tr "org.teams.remove_all_models_desc"}}</p>
	</div>
	{{template "base/delete_modal_actions" .}}
</div>

<div class="ui small basic addall modal">
	<div class="ui icon header">
		<i class="globe icon"></i>
		{{.i18n.Tr "org.teams.add_all_models_title"}}
	</div>
	<div class="content">
		<p>{{.i18n.Tr "org.teams.add_all_models_desc"}}</p>
	</div>
	{{template "base/delete_modal_actions" .}}
</div>

{{template "base/footer" .}}