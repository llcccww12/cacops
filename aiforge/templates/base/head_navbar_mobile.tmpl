<style>
  #navbar-mobile {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    position: relative;
    height: 60px;
    background: rgb(255, 255, 255);
    box-shadow: rgba(16, 16, 16, 0.1) 0px 1px 3px 0px;
  }

  #navbar-mobile .nav-left {
    padding-left: 15px;
  }

  #navbar-mobile .menu-expand-btn-c {
    width: 60px;
    height: 60px;
    margin-left: -15px;
    display: flex;
    align-items:center;
		justify-content: center;
  }
  
  #navbar-mobile .menu-expand-btn-c .menu-expand-btn {    
		width: 32px;
		height: 32px;
		display:flex;
		align-items:center;
		justify-content: center;
		cursor: pointer;
  }

  #navbar-mobile .menu-expand-btn-c .menu-expand-btn.collapsed {
    background: rgb(255, 255, 255);
  }

  #navbar-mobile .nav-left svg {
    cursor: pointer;
  }

  #navbar-mobile .nav-mid .menu-logo-c {
    display: flex;
    align-items: center;
  }
  #navbar-mobile .nav-mid .menu-logo-c .line {
    width: 4px;
		/* height: 17px;
		border-right: 1px solid rgba(187,187,187,1); */
	}
  #navbar-mobile .nav-right {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center; 
  }

  #navbar-mobile .nav-right .svg-c {
    display:flex;
    width:32px;
    height:32px;
    align-items:center;
    justify-content:center;
    border-radius:8px;
    border: 1px solid #D4D6D9;
    cursor: pointer;
  }

  #navbar-mobile .nav-right .svg-c svg path {
    fill: none;
    stroke: rgb(92, 95, 102);
   
  }

  #navbar-mobile .nav-right.expanded .svg-c {    
    border: 1px solid rgba(212,229,255,1);
    background: rgb(230, 240, 255);
  }

  #navbar-mobile .nav-right.expanded .svg-c svg path {    
    stroke: rgb(0, 98, 255);
  }

  #navbar-mobile .expand-pannel {
    position: absolute;
    width: 100%;
    left: 0;
    top: 60px;
    background-color: rgba(16, 16, 16, 0.15);
    overflow: hidden;
    interpolate-size: allow-keywords;
    transition: all .2s ease-in-out;
    height: 0;
    min-height: 0;
    z-index: 9999999;
  }

  #navbar-mobile .expand-pannel #searchForm {
    display: block;
    width: 100%;
    display:flex;
    align-items: center;
    justify-content: center;
  }

  #navbar-mobile .expand-pannel #searchForm .action.input {
    background: rgba(255, 255, 255, 0.1) !important;
    width: 85% !important;
  }

  #navbar-mobile .expand-pannel #searchForm .action.input input[name="q"] {
    color: rgba(255,255,255,0.8);
  }

  #navbar-mobile .expand-pannel #searchForm img[type="submit"] {    
    filter: invert(1);
  }

  #navbar-mobile .expand-pannel .search-bar {
    height: 60px;
    background-color: rgba(0, 102, 255, 1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #navbar-mobile .expand-pannel .menu-list {    
    background-color: rgba(255,255,255,1);
    box-shadow: 0pt 2pt 6pt 0pt rgba(16, 16, 16, 0.3);
    padding: 5pt 38pt;
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c {
    border-bottom: 1px solid rgba(16, 16, 16, 0.05);
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c .menu-item {
    height: 40px;
    display: flex;
    align-items: center;
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c .menu-item .icon-c {
    width: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c .menu-item .title {
    color: rgba(32, 37, 101, 0.9);
    font-size: 14px;
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c .menu-item.focused,
  #navbar-mobile .expand-pannel .menu-list .menu-item-c .sub-menu-item.focused {    
    background-color: rgba(230,240,255,1);
    border-radius: 6px;
  }

  #navbar-mobile .expand-pannel .menu-list .menu-item-c .menu-item.focused .title,
  #navbar-mobile .expand-pannel .menu-list .menu-item-c .sub-menu-item.focused .title {
    color: rgba(0, 26, 199, 1);
    font-weight: 700;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c {}

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .menu-item-c .toggle-icon-c {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    margin-right: 10px;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .menu-item-c .toggle-icon-c svg {
    transition: all .2s ease-in-out;
    transform: rotate(-90deg);
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .menu-item-c.expanded .toggle-icon-c svg {
    transform: rotate(0deg);
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c>.menu-item-c {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .menu-item .menu-item {
    height: 40px;
    display: flex;
    align-items: center;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .sub-menu-list {
    overflow: hidden;
    transition: all .2s ease-in-out;
    height: 0;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .menu-item,
  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .sub-menu-item {
    height: 40px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(16, 16, 16, 0.05);
    color: rgba(32, 37, 101, 0.9);
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .icon-c {
    width: 35px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #navbar-mobile .expand-pannel .menu-list .sub-menu-c .title {
    color: rgba(32, 37, 101, 0.9);
    font-size: 14px;
  }

  #navbar-mobile  .reg-log-c {
    display: flex;
    align-items: center;
    justify-content: center;    
    height: 60px;
  }

  #navbar-mobile .reg-log-c a {  
    color: rgb(0, 26, 199) !important; 
    background: rgb(255, 255, 255);
    border-color: rgb(160, 207, 255);
    border-width: 1px;
    border-style: solid;    
    border-radius: 6px;
    height: 40px;
  }
</style>
