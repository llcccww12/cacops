<style>
	body {
		/*background: linear-gradient(180deg, rgba(0,0,255,0.05) 0%,rgba(255,255,255,0) 100%);*/
	}
	#navbar {
		border-bottom: 1px solid rgba(16,16,16,0.1);
		box-shadow: 0px 1px 3px 0px rgba(16,16,16,0.1);
		height: 60px;
		background-color: rgba(255,255,255,0.5);
    	user-select: none;
		padding: 0 1em !important;
	}
	#navbar .nav-left {
		display: flex;
		align-items: center;
	}
	#navbar .menu-expand-btn-c {
		width: 60px;
		height: 60px;
    margin-left: -1em;
		align-items:center;
		justify-content: center;
	}
	#navbar .menu-expand-btn {
		width: 32px;
		height: 32px;
		display:flex;
		align-items:center;
		justify-content: center;
		cursor: pointer;		
	}
	#navbar .menu-logo-c {
		display: flex;		
    align-items: center;
	}	
	#navbar .menu-logo-c .brand-logo {
		height: 40px;
		width: auto;
		max-width: 220px;
		object-fit: contain;
	}
	#navbar .menu-link {
		display: flex;
		align-items: center;
		height: 100%;
		margin-left: 28px;
	}
	#navbar .menu-link .menu-item {		
		color: rgba(32,37,101,0.9);
		font-size: 16px;
		margin: 0 4px;		
		height: 36px;
		display: flex;
		align-items: center;
		padding: 0 12px;
	}
	#navbar .menu-link .menu-item.focused {
		color: rgba(32,37,101,0.9);
		font-weight: bold;
		font-size: 16px;
		margin: 0 4px;
		border-radius: 15px;
		background-color: rgba(255,255,255,1);
		color: rgba(0,92,255,1);		
		box-shadow: 0px 2px 3px 0px rgba(16,16,16,0.2);
		padding: 0 12px;
	}
	#navbar .menu-link .ui.dropdown.menu-item {
		cursor: pointer;
	}
	#navbar .menu-link .ui.dropdown.menu-item > .menu {
		margin-top: 8px;
		min-width: 148px;
		border: none;
		border-radius: 10px;
		box-shadow: 0 8px 24px rgba(16,16,16,0.12);
		padding: 6px 0;
	}
	#navbar .menu-link .ui.dropdown.menu-item > .menu > .item {
		color: rgba(32,37,101,0.9) !important;
		font-size: 14px;
		padding: 10px 16px !important;
	}
	#navbar .menu-link .ui.dropdown.menu-item > .menu > .item:hover {
		background: rgba(228,241,255,0.7);
		color: rgba(0,26,199,1) !important;
	}
</style>

<style>
#navbar-mobile {
	display: none !important;
}
@media only screen and (max-width: 999.99px) {
	#navbar {
		display: none;
	}
	#navbar-mobile {
		display: flex !important;
	}
	#nav-left-c {
		position: absolute !important;
		width: 100vw;
    background: rgba(16, 16, 16, 0.15) !important;
    z-index: 100000;
	}
	#nav-left-c.collapsed {
		width: auto;
	}
	#nav-left-c #nav-left {    
		background-color: rgba(255,255,255,1);
    box-shadow: 0pt 2pt 6pt 0pt rgba(16,16,16,0.3);
	}
}

@media only screen and (min-width: 1000px) and (max-width: 1530px) {
	#navbar .menu-link.normal {
		display: none;
	}
	#navbar .menu-link.menu-link-expand {
		display: flex;
	}
	#navbar .menu-link .menu-item {
		margin: 0 8px;
		padding: 0 8px;
	}
}
@media only screen and (min-width: 1530px) {
	#navbar .menu-link.normal {
		display: flex;
	}
	#navbar .menu-link.menu-link-expand {	
		display: none;
	}
}
</style>

