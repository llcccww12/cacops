{{if .Dirs}}
<style>
	ul,li{
		list-style: none;
	}
	div#nav{
		border: 1px solid #ccc;
	}
	div#nav ul{
		border-bottom: 1px solid #ccc;
	}
	div#nav li{
		position: relative;
		display: inline-block;
		line-height: 3em;
		text-align: center;
		width: 100%;
		transition: 0.2s all linear;
	}
	div.hide{
		display: none;
	}
	div#nav li.active{
		color: rgba(0,0,0,.85);
		font-weight: 600;
		opacity: 1;
		/*border-bottom: 2px solid rgba(0,0,0,.85);*/
		transition: 0.2s all linear;
	}
	#filelist {
		height: 100%;
    /*height: calc(100% - 46px);*/
    overflow: auto;
	}
	#filelist .file-more,
	#filelist .file-item {
		margin: 10px;
		cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
	}
	#filelist .file-more {
		text-align: center;
    color: #0366d6;
    padding: 6px 3px;			
    background: rgba(16, 16, 16, 0.05);
    color: rgb(22, 132, 252);
	}
	#filelist .file-item.active {
		color: #0366d6;
	}
	.query-timeout {
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
    padding: 0 20px;
    text-align: center;
	}
</style>

<div id="uuid_div" style="display: none">
	<input type="" value="{{$.Uuid}}" id="hide_uuidid" style="display:none;">
	<div id="lang-seemore">{{.i18n.Tr "dataset.see_more"}}</div>
</div>
<div id="myCanvas_div" style="width:100%;height:643px;position: relative;">
	<div id="nav" style="display:inline-block; width:25%;height: 100%; position: relative;vertical-align: top;  background: #ffffff;margin-right: 20px;border-radius: 6px;">
		<ul style="display: flex;padding: 0;margin: 0;">
			<li id="0" class="active">{{.i18n.Tr "dataset.file_list"}}</li>
		</ul>
		<div class="tabpannel ui form" style="max-height:600px;height:calc(100% - 44px);">
			<div class="ui list" id="filelist"></div>
			<div class="query-timeout" style="display:none;">{{.i18n.Tr "dataset.query_timeout_tips"}}</div>
		</div>
		<div class="hide tabpannel">
			<div style="margin-top: 1em;" id="labellist"></div>
		</div>
	</div>
	<div style="display:inline-block; width:71%; height: 100%; position: relative;border: 1px solid #ccc;border-radius: 6px;">
		<div id="win_canvas" style="width:100%;height:643px;;text-align:center;display:flex;align-items:center;justify-content: center;background-color:rgba(16, 16, 16, 0.05)">
